{
  "build": {
    "builder": "nixpacks",
    "config": {
      "phpextensions": [
        "mbstring", "openssl", "pdo", "pdo_mysql",
        "tokenizer", "xml", "fileinfo", "gd"
      ],
      "installCommand": "composer install --no-dev --optimize-autoloader",
      "buildCommand": "php artisan key:generate && php artisan storage:link",
      "postBuildCommand": "php artisan migrate --force && php artisan config:cache"
    }
  },
  "deploy": {
    "startCommand": "php artisan serve --host=0.0.0.0 --port=${PORT} --no-reload"
  }
}
